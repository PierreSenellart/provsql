# PostgreSQL 15+ only (see schedule.common for how tests share a line).
#
# Recursive queries: the planner-hook lowering of WITH RECURSIVE uses
# pg_get_querydef and pg_analyze_and_rewrite_fixedparams, both PG15+;
# reachability, recursion as equations, non-commutative semirings, and the
# case studies with a recursive part (3's network, 7).
test: recursive continuous_recursive_cte btw_recursive btw_hops casestudy7 absorptive_recursion recursion_equations noncommutative_semirings best_path casestudy3_network btw_anyreach btw_tropical btw_cover

# WAL-logging the circuit store through a custom resource manager
# (RegisterCustomRmgr, PG15+): it checks the store as a whole, so it runs
# alone.
test: wal_logging
